# Copy to .env; generate independent random values locally. Never commit the filled file.
HARVEST_DB_PASSWORD=
# hv_ followed by exactly 32 letters/digits.
HARVEST_OPERATOR_KEY=
HARVEST_DB_NAME=harvest_sources
HARVEST_DB_USER=harvest
HARVEST_HTTP_PORT=8397
HARVEST_WORKER_ENABLED=true
HARVEST_SOURCE_AUDIENCE=internal
# Optional approved OLX egress settings.
# HARVEST_INTEGRATIONS_ENABLED=true
# HARVEST_OLX_PROXY_PROFILE=geonode-uz
# HARVEST_PROXY_PROFILES_JSON='{"geonode-uz":{"server":"https://proxy.example:443"}}'
# Inline endpoint settings are an alternative to a named profile.
# HARVEST_OLX_PROXY_SERVER=https://proxy.example:443
# HARVEST_OLX_PROXY_USERNAME=
# HARVEST_OLX_PROXY_PASSWORD=
