<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Form 1: Harvest in the consumer's process, over the consumer's PostgreSQL database (Npgsql, keyed data source).
    Ships its schema as the embedded migration set "harvest" (Migrations/NNN-name/{Apply,Rollback}.sql); the host applies
    it with MigrateHarvestOnStartupAsync (the service does on boot), which also runs the store's self-test.
  -->
  <PropertyGroup>
    <Description>Harvest Form 1: the registry and engine over the consumer's PostgreSQL database, with its SQL migration set and boot self-test.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="WoW2.Sdk.Beta.Be" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\WoW.Two.Sdk.Beta.Be.Harvest.Abstractions.csproj" />
  </ItemGroup>

  <!-- SQL migrations ship embedded (logical name "Migrations/NNN-name/Apply.sql"), resolved by the SDK migrator. -->
  <ItemGroup>
    <EmbeddedResource Include="Migrations\**\*.sql">
      <LogicalName>Migrations/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Harvest.Tests.Unit" />
    <InternalsVisibleTo Include="Harvest.Tests.Integration" />
    <InternalsVisibleTo Include="Harvest.Tests.Migrations" />
  </ItemGroup>

</Project>
