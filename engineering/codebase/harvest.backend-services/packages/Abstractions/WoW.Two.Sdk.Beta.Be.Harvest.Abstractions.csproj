<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Harvest contract: the registration broker and its models, the step-broker contract source adapters implement,
    the capability seams (direct fetching, challenge detection, rendering), reader and extraction output, and delivery
    types.
    It references the kernel WoW2.Sdk.Beta.Be.Abstractions only (Result, AppError, IEvent) — no core, no framework
    reference, no third-party package — and holds no options binding, DI registration or I/O.
  -->
  <PropertyGroup>
    <RootNamespace>WoW.Two.Sdk.Beta.Be.Harvest</RootNamespace>
    <Description>Harvest contract: the registration broker, the step-broker and capability seams, captures, the wow2.post.v1 envelope and delivery types.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WoW2.Sdk.Beta.Be.Abstractions" />
  </ItemGroup>

</Project>
