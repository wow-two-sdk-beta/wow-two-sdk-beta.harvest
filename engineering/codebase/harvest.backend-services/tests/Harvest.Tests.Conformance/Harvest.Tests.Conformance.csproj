<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Conformance tier — the one IRegistrationBroker suite (RegistrationBrokerConformance, shipped in the Testing package)
    run against every implementation: the in-process Module over PostgreSQL in Testcontainers, the Client against the
    service host (in process over PostgreSQL, or a running image when CONFORMANCE_BASE_URL and CONFORMANCE_API_KEY are
    set), and the test kit's fake. Needs Docker unless pointed at a running image.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\packages\Module\WoW.Two.Sdk.Beta.Be.Harvest.Module.csproj" />
    <ProjectReference Include="..\..\packages\Client\WoW.Two.Sdk.Beta.Be.Harvest.Client.csproj" />
    <ProjectReference Include="..\..\packages\Testing\WoW.Two.Sdk.Beta.Be.Harvest.Testing.csproj" />
    <ProjectReference Include="..\..\service\Harvest.Api\Harvest.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\PostgresServer.cs" Link="Shared\PostgresServer.cs" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
