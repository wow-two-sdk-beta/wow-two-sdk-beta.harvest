<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    E2E tier — boots the real Harvest.Api host in-process (WebApplicationFactory via the SDK WebApiTestHost) over a
    PostgreSQL in Testcontainers (postgres:16-alpine, Docker): the store's boot and refusal, API key access, the
    registration wire, the hosted pages, /health and the descriptor's dev check. The SDK testing package brings xunit,
    AwesomeAssertions and Testcontainers transitively.
  -->
  <ItemGroup>
    <PackageReference Include="WoW2.Sdk.Beta.Be.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\service\Harvest.Api\Harvest.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\PostgresServer.cs" Link="Shared\PostgresServer.cs" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
